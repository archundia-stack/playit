# Proveedor de entrega: "mock" (sin red, para probar la interfaz) o "labelgrid"
PROVIDER=mock
PORT=3000
HOST=127.0.0.1

# --- LabelGrid (solo si PROVIDER=labelgrid) ---
# Producción: https://api.labelgrid.com/api/public
# Sandbox:    URL que te asignen (requiere IP permitida + plan API anual)
LABELGRID_API_URL=https://api.labelgrid.com/api/public
# Token Bearer. Vive SOLO en el servidor; nunca llega al navegador.
LABELGRID_TOKEN=
# Secreto del webhook (se muestra al crear el webhook en LabelGrid)
LABELGRID_WEBHOOK_SECRET=

# Persistencia local (JSON) y archivos subidos
DATA_FILE=./data/db.json
UPLOAD_DIR=./data/uploads
